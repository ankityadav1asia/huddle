{
  // The service worker: a classic script (no imports or exports) compiled to public/sw.js, with worker types.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "webworker"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "rootDir": ".",
    "outDir": "../public",
    "skipLibCheck": true
  },
  "files": ["sw.ts"]
}
