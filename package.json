{
  "name": "huddle-watch-along",
  "version": "1.0.0",
  "private": true,
  "description": "Huddle Watch Party prototype: private rooms, realtime chat, match intelligence and an AI Co-host for sports fans.",
  "type": "module",
  "scripts": {
    "build": "tsc -p web",
    "typecheck": "tsc -p . && tsc -p web --noEmit",
    "prestart": "npm run build",
    "start": "node server.ts",
    "dev": "npm run build && node server.ts",
    "test": "node --test \"test/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "0.5.10",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
