# Huddle Watch Party configuration. Copy to .env for local development. Placeholders only: never commit real values.
# With nothing set, `npm start` runs fully offline: embedded database, demo sign-in, no AI provider.

# ---------------------------------------------------------------- server
# PORT=3000
# Server secret for HMACs (OTP codes, phone hashes). Required when hosted; generated into .data/ locally.
# HUDDLE_SECRET=
# Postgres connection string (e.g. Neon). Unset = embedded PGlite database in .data/pglite.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------- sign-in (Indian mobile OTP)
# messagecentral = Message Central VerifyNow (India): it generates, sends and checks the 6-digit SMS code, so Huddle
#                  never sees or stores it. Used automatically when MESSAGECENTRAL_CUSTOMER_ID is set. Production.
# twilio_verify  = Twilio Verify sends and checks the code (needs India DLT registration through Twilio)
# demo           = LOCAL DEVELOPMENT ONLY: no SMS, the code is shown on screen. Refused whenever NODE_ENV=production
#                  or on Vercel, where sign-in stays closed until a real provider is configured.
# OTP_PROVIDER=messagecentral
# From the Message Central console (VerifyNow). The password is a secret: set it only in the server environment.
# MESSAGECENTRAL_CUSTOMER_ID=
# MESSAGECENTRAL_PASSWORD=
# MESSAGECENTRAL_EMAIL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Hard cap on server-sent OTP codes per hour (SMS-pumping cost guard; Firebase has its own quotas).
# OTP_GLOBAL_PER_HOUR=300
# NODE_ENV=production turns on production rules (no demo sign-in, secure cookies, no demo controls).
# Platform moderators, comma-separated +91 numbers. They see the review queue and can end public rooms.
# MODERATOR_PHONES=+919800000001

# ---------------------------------------------------------------- AI Co-host (primary + fallback, server-side only)
# Providers: anthropic | openrouter | gemini. Without AI_PRIMARY/AI_FALLBACK the order is anthropic, openrouter, gemini
# among those with a key. With no key at all the Co-host is off; match alerts and Catch Me Up still work from verified data.
# AI_PRIMARY=anthropic
# AI_FALLBACK=gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=9000
# AI_DEADLINE_MS=16000
# AI_MAX_CONCURRENCY=3
# AI_USER_REQUESTS_PER_5_MIN=6
# AI_ROOM_REQUESTS_PER_10_MIN=30

# ---------------------------------------------------------------- Co-host behaviour
# UNANSWERED_QUESTION_DELAY_SECONDS=25
# CONTINUITY_QUIET_MINUTES=3
# CONTINUITY_COOLDOWN_MINUTES=10

# ---------------------------------------------------------------- big-moment notifications
# Per person per match (1-10, default 8; the last one is kept for the result), and the minimum gap between two.
# MATCH_ALERTS_PER_USER=8
# MATCH_ALERT_MIN_GAP_SECONDS=90

# ---------------------------------------------------------------- browser push (optional)
# Generate with: npx web-push generate-vapid-keys. Local dev generates a pair into .data/vapid.json automatically.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------- rooms, retention, demo
# MESSAGE_RETENTION_HOURS=24
# DELIVERY_RETENTION_HOURS=24
# MODERATION_RETENTION_DAYS=30
# AI_LOG_RETENTION_DAYS=7
# INVITE_TTL_HOURS=48
# PUBLIC_ROOM_MAX_MEMBERS=100
# ROOM_AUTO_END_MINUTES_AFTER_MATCH=10
# PUBLIC_MODERATION_LEVEL=balanced
# Seconds between deliveries in the simulated replay feed.
# DEMO_BALL_SECONDS=10
# Demo controls (jump the replay to a moment). On by default locally, off by default when hosted.
# DEMO_CONTROLS=true
# Bearer secret Vercel Cron sends to /api/cron/sweep.
# CRON_SECRET=
