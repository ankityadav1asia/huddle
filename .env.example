# Copy to .env and set ONE of these. With none, the app runs on its offline engine.

# OpenRouter (one key, many models). Default model: google/gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Anthropic directly
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Google Gemini directly
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
