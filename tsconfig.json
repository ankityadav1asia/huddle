{
  // The server, the Vercel function, tests and scripts. Node runs these .ts files directly (type stripping, Node
  // 22.18+), so only erasable TypeScript is allowed and imports name the .ts file. `npm run typecheck` checks them.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.ts", "api/**/*.ts", "lib/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
